<body>
  <div class="container">
    <header>
      <h1>📋 Planner Semanal</h1>
      <p class="tagline">Tarefas que fluem para a próxima semana</p>
    </header>

    <div class="controls">
      <button onclick="previousWeek()">← Semana Anterior</button>
      <button onclick="goToToday()">Hoje</button>
      <button onclick="nextWeek()">Próxima Semana →</button>
    </div>

    <div class="week-title" id="weekTitle"></div>

    <div class="week-grid" id="weekGrid"></div>

    <div class="stats" id="stats"></div>

    <div class="form-section">
      <div class="form-grid">
        <div class="form-group">
          <label>Título da tarefa</label>
          <input type="text" id="taskTitle" placeholder="Ex: Reunião com cliente, Finalizar relatório">
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div class="form-group">
            <label>Data</label>
            <input type="date" id="taskDate">
          </div>
          <div class="form-group">
            <label>Categoria</label>
            <select id="taskCategory">
              <option value="trabalho">💼 Trabalho</option>
              <option value="pessoal">👤 Pessoal</option>
              <option value="saude">❤️ Saúde</option>
              <option value="estudo">📚 Estudo</option>
              <option value="outro">📌 Outro</option>
            </select>
          </div>
        </div>
      </div>
      <div class="form-actions">
        <button onclick="addTask()">+ Adicionar tarefa</button>
        <button class="cancel" onclick="clearForm()">Limpar</button>
      </div>
    </div>

    <div class="tasks-section">
      <h2 class="section-title">📅 Semana Atual</h2>
      <div class="task-list" id="currentWeekTasks"></div>
    </div>

    <div class="tasks-section">
      <h2 class="section-title">⏰ Próximas Semanas</h2>
      <div class="task-list" id="futureTasks"></div>
    </div>
  </div>

  <script>
    const API_URL = window.location.origin;
    let currentDate = new Date();
    let tasks = [];

    async function fetchTasks() {
      try {
        const response = await fetch(`${API_URL}/api/tasks`);
        tasks = await response.json();
        render();
      } catch (error) {
        console.error('Erro ao carregar tarefas:', error);
      }
    }

    async function addTask() {
      const title = document.getElementById('taskTitle').value.trim();
      const date = document.getElementById('taskDate').value;
      const category = document.getElementById('taskCategory').value;

      if (!title || !date) {
        alert('Preencha título e data');
        return;
      }

      try {
        const response = await fetch(`${API_URL}/api/tasks`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, date, category })
        });

        if (response.ok) {
          clearForm();
          fetchTasks();
        }
      } catch (error) {
        console.error('Erro ao adicionar tarefa:', error);
      }
    }

    async function toggleTask(id, completed) {
      try {
        await fetch(`${API_URL}/api/tasks/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ completed })
        });
        fetchTasks();
      } catch (error) {
        console.error('Erro ao atualizar tarefa:', error);
      }
    }

    async function deleteTask(id) {
      if (!confirm('Tem certeza que deseja deletar esta tarefa?')) return;

      try {
        await fetch(`${API_URL}/api/tasks/${id}`, { method: 'DELETE' });
        fetchTasks();
      } catch (error) {
        console.error('Erro ao deletar tarefa:', error);
      }
    }

    async function postponeTask(id) {
      try {
        await fetch(`${API_URL}/api/tasks/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'postpone' })
        });
        fetchTasks();
      } catch (error) {
        console.error('Erro ao adiar tarefa:', error);
      }
    }

    function clearForm() {
      document.getElementById('taskTitle').value = '';
      document.getElementById('taskDate').value = '';
      document.getElementById('taskCategory').value = 'trabalho';
    }

    function getWeekDates() {
      const start = new Date(currentDate);
      start.setDate(start.getDate() - start.getDay() + 1);

      const dates = [];
      for (let i = 0; i < 7; i++) {
        const d = new Date(start);
        d.setDate(d.getDate() + i);
        dates.push(d.toISOString().split('T')[0]);
      }
      return dates;
    }

    function formatDate(dateStr) {
      const d = new Date(dateStr + 'T00:00:00');
      return d.toLocaleDateString('pt-BR', { day: 'numeric', month: 'short' });
    }

    function previousWeek() {
      currentDate.setDate(currentDate.getDate() - 7);
      render();
    }

    function nextWeek() {
      currentDate.setDate(currentDate.getDate() + 7);
      render();
    }

    function goToToday() {
      currentDate = new Date();
      render();
    }

    function getCategoryEmoji(cat) {
      const emojis = {
        trabalho: '💼',
        pessoal: '👤',
        saude: '❤️',
        estudo: '📚',
        outro: '📌'
      };
      return emojis[cat] || '📌';
    }

    function render() {
      const weekDates = getWeekDates();
      const weekStart = new Date(weekDates[0]);
      const weekEnd = new Date(weekDates[6]);

      const startStr = weekStart.toLocaleDateString('pt-BR', { day: 'numeric', month: 'short' });
      const endStr = weekEnd.toLocaleDateString('pt-BR', { day: 'numeric', month: 'short' });
      document.getElementById('weekTitle').textContent = `Semana de ${startStr} – ${endStr}`;

      // Renderizar dias da semana
      const days = ['Dom', 'Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sab'];
      document.getElementById('weekGrid').innerHTML = weekDates.map((date, i) => {
        const dayTasks = tasks.filter(t => t.date === date && !t.completed).length;
        return `
          <div class="day-card">
            <div class="day-name">${days[new Date(date).getDay()]}</div>
            <div class="day-date">${new Date(date).getDate()}</div>
            ${dayTasks > 0 ? `<div class="day-tasks-count">${dayTasks} tarefas</div>` : ''}
          </div>
        `;
      }).join('');

      // Estatísticas
      const weekTasks = tasks.filter(t => {
        const taskDate = new Date(t.date);
        const weekStart = new Date(weekDates[0]);
        const weekEnd = new Date(weekDates[6]);
        return taskDate >= weekStart && taskDate <= weekEnd;
      });

      const completed = weekTasks.filter(t => t.completed).length;
      const pending = weekTasks.filter(t => !t.completed).length;

      document.getElementById('stats').innerHTML = `
        <div class="stat-card">
          <div class="stat-value">${weekTasks.length}</div>
          <div class="stat-label">Total</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">${completed}</div>
          <div class="stat-label">Concluídas</div>
        </div>
        <div class="stat-card">
          <div class="stat-value">${pending}</div>
          <div class="stat-label">Pendentes</div>
        </div>
      `;

      // Tarefas da semana atual
      const currentWeekTasks = tasks
        .filter(t => {
          const taskDate = new Date(t.date);
          const weekStart = new Date(weekDates[0]);
          const weekEnd = new Date(weekDates[6]);
          return taskDate >= weekStart && taskDate <= weekEnd;
        })
        .sort((a, b) => new Date(a.date) - new Date(b.date));

      document.getElementById('currentWeekTasks').innerHTML = currentWeekTasks.length === 0
        ? '<div class="empty-state"><div class="empty-state-icon">✨</div><p>Nenhuma tarefa esta semana</p></div>'
        : currentWeekTasks.map(task => `
          <div class="task-item ${task.completed ? 'completed' : 'pending'}">
            <input type="checkbox" class="task-checkbox" ${task.completed ? 'checked' : ''} 
              onchange="toggleTask('${task.id}', this.checked)">
            <div class="task-content">
              <div class="task-title">${task.title}</div>
              <div class="task-meta">
                <span>${formatDate(task.date)}</span>
                <span>${getCategoryEmoji(task.category)} ${task.category}</span>
              </div>
            </div>
            <div class="task-actions">
              ${!task.completed ? `<button onclick="postponeTask('${task.id}')">⏭️ Adiar</button>` : ''}
              <button onclick="deleteTask('${task.id}')">🗑️</button>
            </div>
          </div>
        `).join('');

      // Tarefas futuras
      const futureTasks = tasks
        .filter(t => new Date(t.date) > new Date(weekDates[6]))
        .sort((a, b) => new Date(a.date) - new Date(b.date))
        .slice(0, 10);

      document.getElementById('futureTasks').innerHTML = futureTasks.length === 0
        ? '<div class="empty-state"><p>Nenhuma tarefa agendada</p></div>'
        : futureTasks.map(task => `
          <div class="task-item">
            <input type="checkbox" class="task-checkbox" ${task.completed ? 'checked' : ''} 
              onchange="toggleTask('${task.id}', this.checked)">
            <div class="task-content">
              <div class="task-title">${task.title}</div>
              <div class="task-meta">
                <span>${formatDate(task.date)}</span>
                <span>${getCategoryEmoji(task.category)} ${task.category}</span>
              </div>
            </div>
            <div class="task-actions">
              <button onclick="deleteTask('${task.id}')">🗑️</button>
            </div>
          </div>
        `).join('');

      // Setar data padrão para hoje
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('taskDate').value = today;
    }

    // Inicializar
    fetchTasks();
    setInterval(fetchTasks, 30000); // Atualizar a cada 30 segundos
  </script>
</body>
</html>
